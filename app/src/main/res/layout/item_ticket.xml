<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    android:translationZ="2dp"
    app:cardPreventCornerOverlap="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Perforaciones superiores (Efecto tira de ticket) -->
        <LinearLayout
            android:id="@+id/perforationsTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toTopOf="parent">

            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
        </LinearLayout>

        <!-- Contenido del Ticket -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ticketBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            app:layout_constraintTop_toBottomOf="@id/perforationsTop">

            <ImageView
                android:id="@+id/ivPriorityIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/ic_warning" />

            <LinearLayout
                android:id="@+id/llTicketInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@id/ivPriorityIcon"
                app:layout_constraintStart_toEndOf="@id/ivPriorityIcon"
                app:layout_constraintTop_toTopOf="@id/ivPriorityIcon">

                <TextView
                    android:id="@+id/tvTicketId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTicketDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_grey"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/statusBadgeContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@id/ivPriorityIcon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivPriorityIcon">

                <View
                    android:id="@+id/vStatusBg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_status_badge" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_status_badge_gradient" />

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/primary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textAllCaps="true" />
            </FrameLayout>

            <!-- Línea divisoria con muescas laterales -->
            <View
                android:id="@+id/dashedLine"
                android:layout_width="0dp"
                android:layout_height="1.5dp"
                android:layout_marginVertical="20dp"
                android:background="@drawable/bg_dashed_line"
                android:layerType="software"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/llTicketInfo" />

            <TextView
                android:id="@+id/tvTicketTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:textColor="@color/primary_dark"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/dashedLine" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvTicketTitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prioridad: "
                    android:textColor="@color/text_grey"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvPriorityValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Sello de Completado (Invisible por defecto) -->
        <TextView
            android:id="@+id/tvCompletedStamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_completed_stamp"
            android:rotation="-20"
            android:text="RESUELTO"
            android:textColor="#2DC4D4"
            android:textSize="32sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:elevation="10dp" />

        <!-- Muescas laterales (Círculos que "comen" el card) -->
        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_perforation"
            app:layout_constraintBottom_toBottomOf="@id/ticketBody"
            app:layout_constraintEnd_toStartOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/ticketBody" />

        <View
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/bg_perforation"
            app:layout_constraintBottom_toBottomOf="@id/ticketBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ticketBody" />

        <!-- Perforaciones inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/ticketBody">

            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
            <View android:layout_width="8dp" android:layout_height="8dp" android:layout_marginHorizontal="6dp" android:background="@drawable/bg_perforation" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
